# Saathi environment variables: template. Copy to .env and fill in real values.
# The app loads .env automatically at startup (REQ-CFG-01) and never
# overrides variables already set in the environment. Never commit .env.

# Server
PORT=3000
LOG_LEVEL=INFO

# Seed coordinator (first boot only; see README). Leave blank to get a
# random password printed once at first boot.
SAATHI_SEED_PASSWORD=

# Email alerts via Gmail SMTP (REQ-NOTIF-02). Email is disabled when
# SAATHI_SMTP_PASSWORD is empty. Use a Gmail App Password, never your
# regular Gmail password (Google Account > Security > 2-Step Verification
# > App passwords). Never share the password in chat or email.
SAATHI_SMTP_FROM=you@gmail.com
SAATHI_SMTP_USER=you@gmail.com
SAATHI_SMTP_PASSWORD=
SAATHI_SMTP_HOST=smtp.gmail.com
SAATHI_SMTP_PORT=465

# Coordinator alerts go to every coordinator account with a real email
# address, plus this address when set.
SAATHI_COORDINATOR_EMAIL=coordinator@example.com

# Missed-visit scheduler (REQ-NOTIF-03). Interval in seconds; 86400 = once
# a day. The scheduler is disabled when this is empty.
SAATHI_MISSED_CHECK_INTERVAL_SECONDS=86400

# Local development only. Never set outside local development.
# SAATHI_DEV_NO_AUTH=1

# Optional OpenTelemetry export (needs the otel extra).
# OTEL_EXPORTER_OTLP_ENDPOINT=
