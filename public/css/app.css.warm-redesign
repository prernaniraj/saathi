/* Saathi, warm redesign (Nov 21, 2026).
 *
 * Direction: a product a family would trust on the first visit. Warm cream
 * ground, deep pine ink, one saffron highlight for what matters next, and a
 * display serif for headings so the brand has a voice. Light only.
 *
 * Every selector used by the pages and scripts is kept. New hooks used by
 * index.js: .hero, .hero-steps, .step, .step-num, .stat, .empty.
 */

:root {
  --bg: #fbf7f0;
  --surf: #ffffff;
  --ink: #14302b;
  --mute: #5e6f69;
  --line: #e6ded1;
  --pine: #1f5f54;
  --pine-2: #174a42;
  --pine-soft: #e3efec;
  --saffron: #f2a93b;
  --saffron-soft: #fcefd6;
  --warn: #b4442e;
  --warn-bg: #fbeae5;
  --ok: #2f7d5b;
  --ok-bg: #e5f2ea;
  --on: #ffffff;
  --r: 16px;
  --shadow: 0 1px 2px rgb(20 48 43 / 0.05), 0 6px 18px rgb(20 48 43 / 0.06);
  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 16px/1.55 "Instrument Sans", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px 72px; }

/* Brand header: the first thing a visitor sees. */
header {
  margin: 0 -20px;
  padding: 36px 20px 30px;
  background: var(--pine);
  color: var(--on);
  border-radius: 0 0 28px 28px;
  position: relative;
}
header::after {
  content: "";
  position: absolute;
  right: 28px;
  bottom: -6px;
  width: 64px;
  height: 6px;
  border-radius: 6px;
  background: var(--saffron);
}
header h1 {
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(34px, 5vw, 48px);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.05;
}
header h1::after {
  content: "";
  display: inline-block;
  width: 10px;
  height: 10px;
  margin-left: 6px;
  border-radius: 50%;
  background: var(--saffron);
  vertical-align: top;
  margin-top: 14px;
}
header p { color: rgb(255 255 255 / 0.82); max-width: 620px; margin-top: 10px; font-size: 17px; }

/* A quiet line of session info, under the header. */
#shell > .mute { margin: 14px 0 0; }

h1, h2, h3 {
  font-family: "Fraunces", Georgia, serif;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0;
  color: var(--ink);
}
h2 { font-size: 24px; margin: 32px 0 10px; }
h3 { font-size: 19px; }

p { margin: 4px 0; }
strong { font-weight: 600; }
.mute { color: var(--mute); font-size: 14px; }
.flag { color: var(--warn); font-weight: 600; }

a { color: var(--pine); text-decoration: none; font-weight: 500; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }

/* Navigation as a row of pills. */
nav {
  display: flex;
  gap: 6px;
  margin: 22px 0 6px;
  padding: 6px;
  background: var(--surf);
  border: 1px solid var(--line);
  border-radius: 999px;
  overflow-x: auto;
  box-shadow: var(--shadow);
}
nav a {
  padding: 8px 14px;
  color: var(--mute);
  text-decoration: none;
  border-radius: 999px;
  white-space: nowrap;
  font-weight: 500;
  font-size: 15px;
}
nav a:hover { color: var(--ink); background: var(--pine-soft); text-decoration: none; }
nav a[aria-current="page"] { background: var(--pine); color: var(--on); font-weight: 600; }

/* Stage tracker: a stepper with a big number at each stage. */
.path {
  display: flex;
  list-style: none;
  margin: 28px 0 8px;
  padding: 0;
  gap: 12px;
}
.path li {
  flex: 1;
  position: relative;
  background: var(--surf);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 16px 18px 16px;
  box-shadow: var(--shadow);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.path li:hover { transform: translateY(-2px); }
.path li::before { display: none; }
.path li::after { display: none; }
.path b {
  display: block;
  font-family: "Fraunces", Georgia, serif;
  font-size: 40px;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1;
  color: var(--pine);
}
.path span { display: block; margin-top: 6px; font-size: 14px; color: var(--mute); font-weight: 500; }
.path li:last-child b { color: var(--ok); }

/* Cards. */
.cols {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  align-items: start;
}

.card {
  background: var(--surf);
  border: 1px solid var(--line);
  border-radius: var(--r);
  padding: 20px;
  margin-top: 12px;
  box-shadow: var(--shadow);
}
.cols > .card { margin-top: 0; }
.card h3 { margin-bottom: 6px; }

/* The first-run hero on the dashboard. */
.hero {
  background: var(--saffron-soft);
  border: 1px solid #f3d9a6;
  border-radius: 20px;
  padding: 26px 26px 22px;
  margin-top: 22px;
}
.hero h2 { margin: 0 0 6px; font-size: 26px; }
.hero > p { color: #5b4a22; font-size: 16px; max-width: 680px; }

.hero-steps {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
}
.step {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  background: var(--surf);
  border-radius: 14px;
  padding: 14px 16px;
  border: 1px solid #f0e2c3;
}
.step-num {
  flex: 0 0 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--pine);
  color: var(--on);
  font-weight: 600;
  display: grid;
  place-items: center;
  font-size: 14px;
}
.step strong { display: block; }
.step p { font-size: 14px; color: var(--mute); }

/* Empty states read as guidance, not as an error. */
.empty {
  border: 1px dashed var(--line);
  border-radius: 12px;
  padding: 14px 16px;
  color: var(--mute);
  background: #fdfcf9;
}

.stat {
  font-family: "Fraunces", Georgia, serif;
  font-size: 34px;
  font-weight: 600;
  color: var(--pine);
  line-height: 1.1;
}

.chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }

.chip {
  font: inherit;
  font-size: 14px;
  font-weight: 500;
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--surf);
  color: var(--ink);
  cursor: pointer;
  transition: background 0.12s ease, border-color 0.12s ease;
}
.chip:hover { border-color: var(--pine); color: var(--pine); }
.chip[aria-pressed="true"] { background: var(--pine); border-color: var(--pine); color: var(--on); }
.chip.bad { border-color: var(--warn); color: var(--warn); background: var(--warn-bg); }

/* Primary action: pine pill, clearly tappable. */
.btn {
  font: inherit;
  font-weight: 600;
  font-size: 15px;
  padding: 10px 20px;
  border-radius: 999px;
  border: 1px solid var(--pine);
  background: var(--pine);
  color: var(--on);
  cursor: pointer;
  box-shadow: 0 2px 6px rgb(31 95 84 / 0.25);
  transition: background 0.12s ease, transform 0.08s ease;
}
.btn:hover { background: var(--pine-2); border-color: var(--pine-2); }
.btn:active { transform: translateY(1px); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

:focus-visible { outline: 3px solid var(--saffron); outline-offset: 2px; border-radius: 6px; }

form {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  align-items: end;
}
label { display: grid; gap: 6px; font-size: 14px; font-weight: 600; color: var(--ink); }
input, select, textarea {
  font: inherit;
  font-weight: 400;
  color: var(--ink);
  background: var(--surf);
  border: 1px solid #d9cfbd;
  border-radius: 12px;
  padding: 10px 14px;
  min-height: 44px;
}
input::placeholder, textarea::placeholder { color: #8a9893; opacity: 1; }
input:focus, select:focus, textarea:focus {
  border-color: var(--pine);
  outline: none;
  box-shadow: 0 0 0 4px rgb(242 169 59 / 0.35);
}
textarea { grid-column: 1 / -1; min-height: 80px; }

.badge {
  font-size: 12px;
  font-weight: 600;
  background: var(--pine-soft);
  color: var(--pine-2);
  border: 1px solid transparent;
  border-radius: 999px;
  padding: 3px 10px;
}
.badge.flag { background: var(--warn-bg); color: var(--warn); border-color: #f2c4b8; }

.row { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; margin-top: 14px; }
.row label { flex: 1 1 180px; }

details { margin-top: 10px; }
summary { cursor: pointer; font-weight: 600; color: var(--pine); }

pre {
  white-space: pre-wrap;
  overflow-x: auto;
  margin: 8px 0 0;
  background: #faf7f1;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px;
  font: 13px/1.5 ui-monospace, "SF Mono", Menlo, monospace;
}

@media (max-width: 640px) {
  .wrap { padding: 0 14px 56px; }
  header { margin: 0 -14px; padding: 26px 16px 24px; border-radius: 0 0 22px 22px; }
  .path { flex-direction: column; }
  .path b { font-size: 32px; }
  .hero { padding: 20px; }
  nav { border-radius: 16px; }
}
